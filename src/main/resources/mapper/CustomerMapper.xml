<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kleannara.mapper.CustomerMapper">



    <select id="getCustomerText" parameterType="CustomerModel" resultType="CustomerModel">
        SELECT *
        FROM customer_information_log a
        WHERE 1=1
        and category = #{category}
        <if test="version != null and version != ''">
            and version = #{version}
        </if>
        ORDER BY regist_date desc
    </select>
</mapper>